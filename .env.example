# Copy to .env (never commit .env). Server-side only: no key ever reaches the browser.

# Jev (TypeSafe System One API)
TYPESAFE_API_KEY=
JEV_MODEL=jev-latest

# Cloudflare Clef (Workers AI, free tier: 10,000 neurons/day)
CF_ACCOUNT_ID=
CF_API_TOKEN=
CLEF_MODEL=clef

# Claude Opus 5.5 via the Claude Code CLI (run `claude` once and log in)
OPUS_MODEL=claude-opus-5-5
OPUS_EFFORT=high
# CLAUDE_BIN=claude

# GPT-6 Luna via the Codex CLI (run `codex login` once)
LUNA_MODEL=gpt-6-luna
LUNA_EFFORT=low
LUNA_HIGH_EFFORT=high
# CODEX_JS=C:\Users\<you>\AppData\Roaming\npm\node_modules\@openai\codex\bin\codex.js

# Jev + planner lane: time spent shortening the first plan per trial, and solver worker count
PLANNER_BUDGET_MS=8000
# SOLVER_POOL_SIZE=6

# Benchmark policy (same for every model)
MOVE_LIMIT=30
CALL_TIMEOUT_MS=180000
# 0 = no per-trial time limit (the assignment only defines the move limit)
TRIAL_TIME_LIMIT_MS=0
MAX_RETRIES=2
PUZZLE_HOLD_MS=6000
PORT=5050
